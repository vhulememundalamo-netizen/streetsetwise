# Copy to .env (never commit .env). In production use a secret manager instead of a file.
ENV=development

# Database roles are created by infra/db/00_roles.sh. Use three different strong passwords.
POSTGRES_PASSWORD=change-me-superuser
SETWISE_OWNER_PASSWORD=change-me-owner
SETWISE_APP_PASSWORD=change-me-app
SETWISE_MAINT_PASSWORD=change-me-maint
DATABASE_URL=postgresql+psycopg://setwise_app:change-me-app@db:5432/setwise
OWNER_DATABASE_URL=postgresql+psycopg://setwise_owner:change-me-owner@db:5432/setwise
MAINTENANCE_DATABASE_URL=postgresql+psycopg://setwise_maint:change-me-maint@db:5432/setwise

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
EMAIL_HASH_PEPPER=
# Generate each key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma separated. Newest first. Keep old keys until all rows are re-encrypted (key rotation).
FIELD_ENCRYPTION_KEYS=

# Optional AI coach. Leave empty to run the rules coach only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

INFORMATION_OFFICER_EMAIL=privacy@yourdomain.co.za
